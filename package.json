{
  "name": "cuentas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "dev": "bun run build:web && electrobun dev",
    "app:run": "electrobun run",
    "build": "bun run make:icon && bun run patch:icons && bun run build:web && electrobun build --env=stable",
    "build:canary": "bun run make:icon && bun run patch:icons && bun run build:web && electrobun build --env=canary",
    "make:icon": "bun run scripts/make-icon.ts",
    "patch:icons": "bun run scripts/patch-electrobun-icons.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "bun run check && eslint ."
  },
  "dependencies": {
    "electrobun": "^1.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "pdfjs-dist": "^4.10.38",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0"
  }
}
